{
  "_version": "1.2",
  "_description": "LAN Monitor — Router Model Knowledge Base. User-editable. Each entry maps known model/manufacturer name fragments (case-insensitive substring match) to capabilities and router class. Entries are matched in array order; place more specific keywords BEFORE generic ones, and use \"priority\" to force resolution when multiple entries match the same banner.",
  "_schema": {
    "keywords": "Array of lowercase substrings to match against sysDescr / HTTP banner / UPnP modelName (any match wins)",
    "priority": "Integer, higher wins on multi-match ties. Default 0 if omitted. Generic speed-class keywords (e.g. 'ax1800') should be priority 0; exact model numbers should be 5+.",
    "manufacturer": "Canonical display name for the manufacturer",
    "class": "home | smb | enterprise | isp-cpe",
    "caps": {
      "hasGuestWifi": "boolean",
      "hasVPN": "boolean",
      "hasQoS": "boolean",
      "hasDualBand": "boolean",
      "hasTriBand": "boolean",
      "hasIPv6": "boolean",
      "hasWPA3": "boolean",
      "defaultCredsRisk": "boolean — model line has a well-documented history of unchanged/weak default admin credentials",
      "firmwareRisk": "low | medium | high — subjective rating of how often this line ships critical unpatched CVEs / has reached EOL"
    },
    "lastUpdated": "ISO date string — when this entry's data was last verified"
  },
